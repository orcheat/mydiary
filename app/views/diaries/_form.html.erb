<%= form_with(model: diary, class: "space-y-6") do |form| %>
  <% if diary.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-600 p-4 rounded-xl border border-red-100 mb-8">
      <div class="flex items-center gap-2 font-bold mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <%= pluralize(diary.errors.count, "error") %> prohibited this entry from being saved:
      </div>
      <ul class="list-disc ml-8 text-sm space-y-1">
        <% diary.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_field :title, 
        placeholder: "Give your memory a title...",
        class: "block w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all duration-200" %>
  </div>

  <div>
    <%= form.label :description, "Write your thoughts", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_area :description, 
        rows: 10,
        placeholder: "What's on your mind today?",
        class: "block w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all duration-200" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :color, "Entry accent color", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <div class="flex items-center gap-3">
        <%= form.color_field :color, 
            class: "h-12 w-12 rounded-lg border border-gray-200 cursor-pointer p-1" %>
        <span class="text-sm text-gray-500 italic">Personalize the feel of this memory</span>
      </div>
    </div>
  </div>

  <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-4">
    <%= link_to "Cancel", (diary.new_record? ? root_path : diary), class: "text-sm font-semibold text-gray-500 hover:text-gray-700" %>
    <%= form.submit class: "cursor-pointer rounded-xl bg-indigo-600 px-8 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200" %>
  </div>
<% end %>
