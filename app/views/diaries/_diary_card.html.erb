<div id="<%= dom_id diary %>" class="group bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-indigo-100 transition-all duration-200 flex flex-col relative">
  <%= link_to diary, class: "absolute inset-0 z-0" do %>
    <span class="sr-only">Read entry: <%= diary.title %></span>
  <% end %>

  <div class="p-6 flex-grow flex flex-col relative z-10 pointer-events-none">
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-3 h-3 rounded-full" style="background-color: <%= diary.color.present? ? diary.color : '#6366f1' %>;"></div>
        <h3 class="text-xl font-bold text-gray-900 group-hover:text-indigo-600 transition-colors duration-200">
          <%= diary.title %>
        </h3>
      </div>
      <span class="text-xs font-medium text-gray-400 bg-gray-50 px-2 py-1 rounded-md">
        <%= diary.created_at.strftime("%b %d, %Y") %>
      </span>
    </div>

    <p class="text-gray-600 mb-6 leading-relaxed">
      <%= truncate(diary.description, length: 250) %>
    </p>

    <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-end">
      <div class="pointer-events-auto">
        <%= link_to edit_diary_path(diary), class: "p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all flex items-center gap-1", title: "Edit entry" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span class="text-xs font-semibold">Edit</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
