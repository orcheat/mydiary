<div id="<%= dom_id diary %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= diary.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= diary.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Color:</strong>
    <%= diary.color %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= diary.user_id %>
  </div>
</div>
