<div class="max-w-3xl mx-auto px-4 py-12">
  <div class="mb-8 flex items-center justify-between">
    <%= link_to root_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900 flex items-center gap-2 group" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to all entries
    <% end %>

    <div class="flex items-center gap-3">
      <%= link_to "Edit entry", edit_diary_path(@diary), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 px-4 py-2 rounded-xl transition-colors" %>
      <%= button_to @diary, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this memory?" }, class: "text-sm font-semibold text-red-600 hover:text-red-700 bg-red-50 px-4 py-2 rounded-xl transition-colors cursor-pointer" do %>
        Delete
      <% end %>
    </div>
  </div>

  <article class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="h-3 w-full" style="background-color: <%= @diary.color.present? ? @diary.color : '#6366f1' %>;"></div>
    
    <div class="p-8 md:p-12">
      <header class="mb-10">
        <div class="flex items-center gap-2 text-sm font-medium text-gray-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <%= @diary.created_at.strftime("%A, %B %d, %Y") %>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight">
          <%= @diary.title %>
        </h1>
      </header>

      <div class="prose prose-indigo prose-lg max-w-none text-gray-700 leading-relaxed whitespace-pre-wrap">
        <%= @diary.description %>
      </div>
    </div>
  </article>
</div>
