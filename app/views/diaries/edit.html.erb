<div class="max-w-3xl mx-auto px-4 py-12">
  <div class="mb-10 text-center">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Edit Memory</h1>
    <p class="text-gray-500 italic">Refine your thoughts and memories.</p>
  </div>

  <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-12">
    <%= render "form", diary: @diary %>
  </div>

  <div class="mt-8 text-center">
    <%= link_to "Show this diary", @diary, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>
  </div>
</div>
