<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8 bg-gradient-to-br from-indigo-50 via-white to-gray-50">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
        <%= title_prefix %>
        <span class="text-indigo-600"><%= title_highlight %></span>
      </h1>
      <% if local_assigns[:subtitle] %>
        <p class="mt-2 text-sm text-gray-500 sm:text-base"><%= subtitle %></p>
      <% end %>
    </div>

    <div class="rounded-2xl border border-gray-100 bg-white/80 backdrop-blur-sm shadow-xl shadow-gray-200/50 p-8">
      <%= yield %>
    </div>

    <div class="mt-6 text-center text-sm text-gray-500">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
