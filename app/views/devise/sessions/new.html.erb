<% input_class = "block w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all duration-200" %>
<% label_class = "block text-sm font-medium text-gray-700 mb-1.5" %>

<%= render layout: "devise/shared/auth_layout", locals: { title_prefix: "Welcome ", title_highlight: "back", subtitle: "Sign in to continue your journal" } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
    <div>
      <%= f.label :email, class: label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: input_class %>
    </div>

    <div>
      <%= f.label :password, class: label_class %>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password", class: input_class %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500/20" %>
        <%= f.label :remember_me, class: "text-sm text-gray-600" %>
      </div>
    <% end %>

    <div class="pt-1">
      <%= f.submit "Log in", class: "w-full cursor-pointer rounded-xl bg-gray-900 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 transition-all duration-200" %>
    </div>
  <% end %>
<% end %>
